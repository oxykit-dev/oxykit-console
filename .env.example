# Modules are public/config.json (mail, render, flow). Edit that file; no rebuild.

# Leave unset in `npm run dev`. Vite proxies /api/v1 and /hubs to Mail :5026,
# /api/render to Render :5066, and /api/flow to Flow :5077.
# Set an absolute URL to call a host directly (Mail must allow this origin).
# VITE_BACKEND_URL=http://127.0.0.1:5026
# VITE_SIGNALR_HUB_URL=/hubs
# VITE_RENDER_URL=/api/render
# VITE_FLOW_URL=/api/flow

# Optional dev API keys. A saved key in the Connection panel wins.
# VITE_RENDER_API_KEY=
# VITE_FLOW_API_KEY=
